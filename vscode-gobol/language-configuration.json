{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "@\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" }
  ],
  "wordPattern": "(@?[a-zA-Z_][a-zA-Z0-9_]*|::)",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*((func|if|else|for|while|match|impl|trait|struct|enum|extern|static|operator|constructor|type|where)\\s+.*|.*(\\{|\\[|\\(|=>))\\s*$",
    "decreaseIndentPattern": "^\\s*(\\}|\\)|\\])\\s*$"
  },
  "folding": {
    "markers": {
      "start": "^\\s*//\\s*#?region\\b.*",
      "end": "^\\s*//\\s*#?endregion\\b.*"
    }
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*(?:(?:func|if|else|for|while|match|impl|trait|struct|enum|extern|constructor|static|operator).*?)?\\{\\s*$",
      "action": {
        "indent": "indent",
        "appendText": "",
        "removeText": 0
      }
    },
    {
      "beforeText": "^\\s*\\/\\*\\*(?!.*\\*\\/).*$",
      "action": {
        "indent": "indent",
        "appendText": " * ",
        "removeText": 0
      }
    },
    {
      "beforeText": "^\\s*(\\/\\/.*)$",
      "action": {
        "indent": "none",
        "appendText": "// ",
        "removeText": 0
      }
    }
  ],
  "colorizedBracketPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ]
}
