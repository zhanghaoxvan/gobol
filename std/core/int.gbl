import core::ops;
import core::cmp;

#[builtin("int32")]
struct int {}

impl ops::Add for int {
    #[intrinsic("i32_add")]
    func add(self, other: int): int;
}

impl ops::Sub for int {
    #[intrinsic("i32_sub")]
    func sub(self, other: int): int;
}

impl ops::Mul for int {
    #[intrinsic("i32_mul")]
    func mul(self, other: int): int;
}

impl ops::Div for int {
    #[intrinsic("i32_div")]
    func div(self, other: int): int;
}

impl ops::Rem for int {
    #[intrinsic("i32_rem")]
    func rem(self, other: int): int;
}

impl cmp::Eq for int {
    #[intrinsic("i32_eq")]
    func eq(self, other: int): bool;
}

impl cmp::Cmp for int {
    #[intrinsic("i32_lt")]
    func lt(self, other: int): bool;

    #[intrinsic("i32_le")]
    func le(self, other: int): bool;

    #[intrinsic("i32_gt")]
    func gt(self, other: int): bool;

    #[intrinsic("i32_ge")]
    func ge(self, other: int): bool;
}
