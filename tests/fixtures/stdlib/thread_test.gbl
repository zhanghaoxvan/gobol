import thread;

func worker(): int {
    io::println("Hello from thread");
    0
}

func add_one(n: int): int {
    io::println(@"add_one got: {n}");
    n + 1
}

func double_arg(n: int): int {
    io::println(@"double_arg got: {n}");
    n * 2
}

func main() {
    var t0 = Thread::spawn(&worker);
    t0.join();

    var t1 = Thread::spawn(&add_one, 41);
    t1.join();

    var t2 = Thread::spawn(&double_arg, 21);
    t2.join();
}
