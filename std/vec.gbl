// user don't need this name directly
// it's the base database of the gobol
// when user use the 'type[<the inital count of the vec and don't must complete this>]'
// like var v: int[] => var v: new vec<int>()
// or var v1: int[32] => var v1: new vec<int>()
// it calls this library
#[library_features(hidden = true)]

import ref;
import iterator;

struct Vec<T> {
    _data: T[]?,
    _len: int,
    _cap: int
};

impl<T> New<T> for Vec<T> {
    func new(): Vec<T> {
        _data = null;
        _len = 0;
        _cap = 0;
        self
    }

    func new(arr: T[]): Vec<T> {
        var v: Vec<T> = new Vec<T>();
        for item in arr {
            v.push(item);
        }
        v
    }
    
    func new(capacity: int): Vec<T> {
        _data = new T[capacity]?;
        _len = 0;
        _cap = capacity;
        self
    }
}

impl<T> Vec<T> {
    func len(self): int {
        _len
    }
    
    func cap(self): int {
        _cap
    }
    
    func is_empty(self): bool {
        _len == 0
    }
    
    func get(self, index: int): T {
        if index < 0 || index >= _len { 
            panic("index out of bounds"); 
        }
        _data[index]
    }
    
    func set(self, index: int, value: T) {
        if index < 0 || index >= _len { 
            panic("index out of bounds"); 
        }
        _data[index] = value;
    }
    
    func push(self, value: T) {
        if _len >= _cap {
            self._grow();
        }
        if _data == null {
            _data = new T[4]?;
            _cap = 4;
        }
        _data[_len] = value;
        _len += 1;
    }
    
    func pop(self): T {
        if _len == 0 { 
            panic("pop from empty vec"); 
        }
        _len -= 1;
        var value: T = _data[_len];
        _data[_len] = null;
        value
    }
    
    convert T[](self): T[] {
        var result: T[] = new T[_len];
        for i in 0.._len {
            result[i] = _data[i];
        }
        result
    }
    
    func iter(self): VecIterator<T> {
        VecIterator<T>::new(_data, _len)
    }

    func index(self, index: int): T {
        self.get(index)
    }

    func index_mut(self, index: int): Ref<T> {
        if index < 0 || index >= _len {
            panic("index out of bounds");
        }
        var addr = gobol_array_elem_addr(_data, index);
        Ref<T>::new(addr)
    }

    func _grow(self) {
        var new_cap: int = 0;
        if _cap == 0 {
            new_cap = 4;
        } else {
            new_cap = _cap * 2;
        }
        var new_data: T[] = new T[new_cap]?;
        for i in 0.._len {
            new_data[i] = _data[i];
        }
        _data = new_data;
        _cap = new_cap;
    }
};

struct VecIterator<T> {
    _data: T[]?,
    _len: int,
    _index: int
};

impl<T> New<T> for VecIterator<T> {
    func new(data: T[]?, len: int): VecIterator<T> {
        VecIterator { _data: data, _len: len, _index: 0 }
    }
}

impl<T> Iterator<T> for VecIterator<T> {
    type Value = T;
    func next(self): Option<T> {
        if _index >= _len {
            return Option::None();
        }
        var value: T = _data[_index];
        _index += 1;
        Option::Some(value)
    }
};