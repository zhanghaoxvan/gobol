import std;

struct Point {
    x: int,
    y: int,
};

impl New for Point {
    func new(x: int, y: int): Point {
        self.x = x;
        self.y = y;
        self
    }
};

func add(p: Point): int {
    p.x + p.y
}

func main() {
    var name: str = "Gobol";
    var arr: int[10][10];
    arr[2][2] = 114514;
    var flag: bool = true;
    std::io::print(@"Hello from {name}\n");
    std::io::print(@"arr[2] is {arr[2][2]}!\n");

    for i in 0..10 {
        std::io::print(@"Number {i}\n");
    }

    var p: Point = Point(1, 2);
    
    std::io::print(@"Calc: {add(p)}\n");

    if arr[2][2] == 114514 {
        std::io::print("Right!\n");
    } else {
        std::io::print("Wrong!\n");
    }
    
    std::io::print("End of Task!\n");

    // New feature: match expression
    var grade = match 85 {
        100 => "A+",
        90 => "A",
        _ => "B"
    };
    std::io::print(@"Grade: {grade}\n");

    // New feature: block expression
    var doubled = {
        var tmp = p.x + p.y;
        tmp * 2
    };
    std::io::print(@"Doubled: {doubled}\n");

    // New feature: extended for (index + value)
    var items: Vec<int> = [10, 20, 30];
    std::io::print("Items: ");
    for i, v in items {
        std::io::print(i);
        std::io::print(":");
        std::io::print(v);
        std::io::print(" ");
    }
    std::io::print("\n");

    // New feature: string iteration
    std::io::print("Chars: ");
    for ch in "Go" {
        std::io::print(ch);
    }
    std::io::print("\n");

}
