// net_test.gbl — Network tests

func test_connect_timeout(): bool {
    var result = TcpStream::connect("127.0.0.1", 99999, 1000);
    match result {
        Ok(_) => false,
        Err(_) => true
    }
}

func test_invalid_port(): bool {
    var result = TcpStream::connect("127.0.0.1", 0, 100);
    match result {
        Ok(_) => false,
        Err(_) => true
    }
}

func test_empty_address(): bool {
    var result = TcpStream::connect("", 8080, 100);
    match result {
        Ok(_) => false,
        Err(_) => true
    }
}

func test_dns_resolution(): bool {
    var result = TcpStream::connect("localhost", 99999, 1000);
    match result {
        Ok(_) => true,
        Err(_) => true
    }
}

func test_ipv6(): bool {
    var result = TcpStream::connect("::1", 99999, 1000);
    match result {
        Ok(_) => true,
        Err(_) => true
    }
}

func test_listener_bind(): bool {
    var result = TcpListener::bind("127.0.0.1", 18080, 128, false);
    match result {
        Ok(listener) => {
            listener.close();
            true
        },
        Err(_) => false
    }
}

func test_bind_dual_stack(): bool {
    var result = TcpListener::bind("::", 18081, 128, false);
    match result {
        Ok(listener) => {
            listener.close();
            true
        },
        Err(_) => false
    }
}

func test_keepalive(): bool {
    var conn = match TcpStream::connect("127.0.0.1", 18080, 5000) {
        Ok(c) => c,
        Err(_) => return true
    };
    var result = conn.set_keepalive(true, 30, 10, 3);
    var ok = match result {
        Ok(_) => true,
        Err(_) => false
    };
    conn.close();
    ok
}

func test_addresses(): bool {
    var listener = match TcpListener::bind("127.0.0.1", 18082, 128, false) {
        Ok(l) => l,
        Err(_) => return false
    };
    var conn = match TcpStream::connect("127.0.0.1", 18082, 5000) {
        Ok(c) => c,
        Err(_) => {
            listener.close();
            return false
        }
    };
    var local_ok = match conn.local_addr() {
        Ok(_) => true,
        Err(_) => false
    };
    var remote_ok = match conn.remote_addr() {
        Ok(_) => true,
        Err(_) => false
    };
    conn.close();
    listener.close();
    local_ok && remote_ok
}

func test_is_alive(): bool {
    var listener = match TcpListener::bind("127.0.0.1", 18083, 128, false) {
        Ok(l) => l,
        Err(_) => return false
    };
    var conn = match TcpStream::connect("127.0.0.1", 18083, 5000) {
        Ok(c) => c,
        Err(_) => {
            listener.close();
            return false
        }
    };
    var result = conn.is_alive();
    conn.close();
    listener.close();
    result
}

func main(): int {
    io::println("=== Net Module Tests ===");

    var tests: [(str, func(): bool)] = [
        ("connect_timeout", test_connect_timeout),
        ("invalid_port", test_invalid_port),
        ("empty_address", test_empty_address),
        ("dns_resolution", test_dns_resolution),
        ("ipv6", test_ipv6),
        ("listener_bind", test_listener_bind),
        ("bind_dual_stack", test_bind_dual_stack),
        ("keepalive", test_keepalive),
        ("addresses", test_addresses),
        ("is_alive", test_is_alive),
    ];

    var passed = 0;
    var failed = 0;

    for test in tests {
        var name = test.0;
        var fn_ptr = test.1;
        if fn_ptr() {
            passed = passed + 1;
        } else {
            io::println(@"FAIL: {name}");
            failed = failed + 1;
        }
    }

    io::println(@"Passed: {passed}, Failed: {failed}");

    if failed == 0 {
        0
    } else {
        1
    }
}