func main() {
    // Simple immediate invocation: no capture
    var a = lambda(x: int): int { x + 1 }(10);
    io::println(@"no capture: {a}");

    // Capture a var from the enclosing scope
    var base = 100;
    var b = lambda(x: int): int { x + base }(5);
    io::println(@"captured base: {b}");

    // Capture multiple vars
    var m = 3;
    var n = 7;
    var c = lambda(x: int): int { x * m + n }(2);
    io::println(@"captured m and n: {c}");

    // Lambda with no parameters
    var d = lambda(): int { 42 }();
    io::println(@"no params: {d}");

    // Generic lambda
    var e = lambda<T>(x: int): int { x }(9);
    io::println(@"generic: {e}");
}
