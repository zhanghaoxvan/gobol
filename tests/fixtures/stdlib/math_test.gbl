import std;

func main() {
    var x = 3.0;
    var y = 4.0;

    var a = math::abs(-5.0);
    io::println(@"abs(-5): {a}");

    var mx = math::max(x, y);
    io::println(@"max(3, 4): {mx}");

    var mn = math::min(x, y);
    io::println(@"min(3, 4): {mn}");

    var sq = math::sqrt(16.0);
    io::println(@"sqrt(16): {sq}");

    var p = math::pow(2.0, 10.0);
    io::println(@"pow(2, 10): {p}");

    var s = math::sin(0.0);
    io::println(@"sin(0): {s}");

    var c = math::cos(0.0);
    io::println(@"cos(0): {c}");
}
