#[library_features(hidden = true)]

import iterator::Iterator;

struct Range {
    _start: int,
    _end: int,
    _step: int
}

struct RangeIterator {
    _current: int,
    _end: int,
    _step: int
}

impl New for Range {
    func new(start: int, end: int): Range {
        Range {
            _start: start,
            _end: end,
            _step: 1,
        }
    }

    func new(start: int, end: int, step: int): Range {
        Range {
            _start: start,
            _end: end,
            _step: step,
        }
    }
}

impl Range {
    convert int[](self): int[] {
        var result: int[];
        var i: int = self._start;
        if self._step > 0 {
            while i < self._end {
                result.add(i);
                i += self._step;
            }
        } else {
            while i > self._end {
                result.add(i);
                i += self._step;
            }
        }
        result
    }


    func start(self): int { self._start }
    func end(self): int { self._end }
    func step(self): int { self._step }

    func len(self): int {
        if self._step == 0 { return 0; }
        if self._step > 0 {
            if self._start >= self._end { return 0; }
            (self._end - self._start + self._step - 1) / self._step
        } else {
            if self._start <= self._end { return 0; }
            (self._start - self._end - self._step - 1) / (-self._step)
        }
    }

    func contains(self, value: int): bool {
        if self._step > 0 {
            value >= self._start && value < self._end && (value - self._start) % self._step == 0
        } else {
            value <= self._start && value > self._end && (value - self._start) % self._step == 0
        }
    }
}

impl New for RangeIterator {
    func new(current: int, end: int, step: int): RangeIterator {
        RangeIterator {
            _current: current,
            _end: end,
            _step: step,
        }
    }
}

impl RangeIterator {
    func next(self): (int, bool) {
        if self._step > 0 {
            if self._current >= self._end { return (0, false); }
        } else {
            if self._current <= self._end { return (0, false); }
        }
        var value: int = self._current;
        self._current = self._current + self._step;
        (value, true)
    }
}
