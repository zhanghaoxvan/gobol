// std/new.gbl - Constructor trait.
//
// `new Type(args)` desugars to a constructor call on Type. By convention,
// types that support construction via `new` should implement `New<T>`,
// which declares the `new` static method returning the type itself.
//
// Example:
//   struct Range { _start: int, _end: int }
//   impl New<Range> for Range {
//       func new(start: int, end: int): Range { _start = start; _end = end; self; }
//   }
//   var r = new Range(0, 10);

trait New<T> {
    func new(): T
}
