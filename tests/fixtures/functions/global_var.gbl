import std;

// Module-level mutable `var`: shared storage visible to every function.
var counter: int = 0;

func bump(): bool {
    counter = counter + 1;
    true
}

func main() {
    counter = 0;
    bump();
    bump();
    bump();
    io::print(@"after 3 bumps: {counter}\n");  // 3
    counter = counter + 10;
    io::print(@"after +10: {counter}\n");      // 13
}
