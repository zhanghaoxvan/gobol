// std/thread.gbl — Thread and Channel concurrency primitives.
//
// Thread wraps a system thread (pthread on POSIX, CreateThread on Windows).
// Channel<T> provides a synchronised single-element message queue for
// communication between threads.
//
// The C runtime (std/runtime.c) provides the underlying implementations:
//   gobol_thread_spawn, gobol_thread_join,
//   gobol_chan_create, gobol_chan_send, gobol_chan_recv, gobol_chan_destroy.

import result;

// The thread/channel C helpers used below (`gobol_thread_spawn`,
// `gobol_thread_join`, `gobol_chan_*`) are declared once in
// std/builtins.gbl, which every Gobol program auto-imports.

#[library_features(hidden = true)]

struct Thread {
    _id: int
}

impl Thread {
    // Spawn a new thread running `f` with no argument.
    // f must be a zero-argument function whose address is known at link time.
    func spawn(f: func(): int): Thread {
        _id = builtins::gobol_thread_spawn(0, 0);
        self
    }

    // Wait for the thread to finish and return its exit code.
    func join(self): int {
        builtins::gobol_thread_join(_id)
    }

    func id(self): int {
        _id
    }
}

struct Channel<T> {
    _handle: int
}

impl<T> Channel<T> {
    func new(): Channel<T> {
        _handle = builtins::gobol_chan_create();
        self
    }

    // Send a value into the channel. Returns 0 on success, -1 on failure.
    func send(self, value: T): int {
        builtins::gobol_chan_send(_handle, value)
    }

    // Receive a value from the channel. Blocks until a value is available.
    // Returns Result<T, int>: Ok(value) on success, Err(-1) if channel closed.
    func recv(self): Result<T, int> {
        var value = builtins::gobol_chan_recv(_handle);
        // TODO: distinguish "value 0" from "channel closed" via status out-param
        Result<T, int>::Ok(value)
    }

    func drop(self) {
        builtins::gobol_chan_destroy(_handle);
    }
}
