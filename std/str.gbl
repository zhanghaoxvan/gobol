// std/str.gbl — String extension methods.
//
// Provides utility methods on the built-in `str` primitive type.
// All methods are `#[intrinsic]` — the actual implementation is
// supplied by the C runtime (runtime.c) and dispatched directly
// by the Cranelift backend.

impl str {
    #[intrinsic("str_len")]
    func len(self): int;

    #[intrinsic("str_contains")]
    func contains(self, substr: str): bool;

    #[intrinsic("str_trim")]
    func trim(self): str;

    #[intrinsic("str_replace")]
    func replace(self, old: str, to: str): str;

    #[intrinsic("str_starts_with")]
    func starts_with(self, prefix: str): bool;

    #[intrinsic("str_ends_with")]
    func ends_with(self, suffix: str): bool;

    #[intrinsic("str_index_of")]
    func index_of(self, substr: str): int;

    #[intrinsic("str_count")]
    func count(self, substr: str): int;

    #[intrinsic("str_to_upper")]
    func to_upper(self): str;

    #[intrinsic("str_to_lower")]
    func to_lower(self): str;
};
