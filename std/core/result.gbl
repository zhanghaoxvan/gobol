#![library_features(hidden = true)]

enum Result<T, E> {
    Ok(T),
    Err(E),
}

impl<T, E> Result<T, E> {
    func is_ok(self): bool {
        self._tag == 0
    }

    func is_err(self): bool {
        self._tag == 1
    }

    func value(self, default: T): T {
        if self.is_ok() {
            self._0
        } else {
            default
        }
    }

    func unwrap_or(self, default: T): T {
        self.value(default)
    }

    func or_else(self, fallback: func(E): T): T {
        if self.is_ok() {
            self._0
        } else {
            fallback(self._1)
        }
    }

    func map<U>(self, f: func(T): U): Result<U, E> {
        if self.is_ok() {
            Result<U, E>::Ok(f(self._0))
        } else {
            Result<U, E>::Err(self._1)
        }
    }
}
