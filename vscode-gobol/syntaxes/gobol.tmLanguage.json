{
  "scopeName": "source.gobol",
  "patterns": [{ "include": "#main" }],
  "repository": {
    "main": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#attributes" },
        { "include": "#strings" },
        { "include": "#chars" },
        { "include": "#numbers" },
        { "include": "#imports" },
        { "include": "#generics" },
        { "include": "#keywords" },
        { "include": "#types" },
        { "include": "#identifiers" },
        { "include": "#operators" }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.block.gobol",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [{ "include": "#comments" }]
        },
        {
          "name": "comment.line.double-slash.gobol",
          "match": "//.*$"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute.gobol",
          "begin": "#\\[",
          "end": "\\]",
          "patterns": [
            {
              "name": "entity.other.attribute-name.gobol",
              "match": "\\b[[:alpha:]_][[:word:]]*\\b"
            },
            {
              "name": "string.quoted.double.gobol",
              "match": "\"[^\"]*\""
            }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.gobol",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.gobol",
              "match": "\\\\(u\\{[0-9a-fA-F]+\\}|x[0-9a-fA-F]{2}|.)"
            }
          ]
        },
        {
          "name": "string.quoted.format.gobol",
          "begin": "@\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.gobol",
              "match": "\\\\(u\\{[0-9a-fA-F]+\\}|x[0-9a-fA-F]{2}|.)"
            },
            {
              "name": "meta.interpolation.gobol",
              "begin": "\\{",
              "end": "\\}",
              "patterns": [{ "include": "#main" }]
            }
          ]
        }
      ]
    },
    "chars": {
      "patterns": [
        {
          "name": "string.quoted.single.char.gobol",
          "match": "'([^'\\\\]|\\\\(u\\{[0-9a-fA-F]+\\}|x[0-9a-fA-F]{2}|.))'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.gobol",
          "match": "\\b[0-9][0-9_]*(\\.[0-9][0-9_]*)?([eE][+-]?[0-9_]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.hex.gobol",
          "match": "\\b0x[0-9a-fA-F][0-9a-fA-F_]*\\b"
        },
        {
          "name": "constant.numeric.integer.binary.gobol",
          "match": "\\b0b[01][01_]*\\b"
        },
        {
          "name": "constant.numeric.integer.octal.gobol",
          "match": "\\b0o[0-7][0-7_]*\\b"
        },
        {
          "name": "constant.numeric.integer.decimal.gobol",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "generics": {
      "patterns": [
        {
          "comment": "Only open a generic list when the `<` is directly attached to a preceding name (e.g. `Vec<T>`, `map<U>`, `impl<T>`). This keeps bare comparison operators like `i < 0` or `x >= 1` from being swallowed by `meta.generics.gobol`.",
          "name": "meta.generics.gobol",
          "begin": "(?<=[[:alpha:]_])<",
          "end": ">",
          "patterns": [
            { "include": "#generics" },
            { "include": "#types" },
            { "include": "#keywords" },
            {
              "name": "punctuation.separator.comma.gobol",
              "match": ","
            },
            {
              "name": "punctuation.separator.colon.gobol",
              "match": ":"
            },
            {
              "name": "keyword.operator.bound.gobol",
              "match": "\\+"
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.gobol",
          "match": "\\b(if|else|for|while|return|break|continue|in|match|loop)\\b"
        },
        {
          "name": "keyword.declaration.gobol",
          "match": "\\b(func|var|val|struct|enum|impl|trait|extern|import|from|export|as|convert|operator|constructor|static|type|where)\\b"
        },
        {
          "comment": "`new` is only a keyword in allocation context (new T[..] / new Type(..)). When used as a function/method name (func new(), Vec::new()), it must NOT be highlighted as a keyword — the function-name pattern in #identifiers will catch it instead.",
          "name": "keyword.other.new.gobol",
          "match": "\\bnew\\b(?=\\s+[A-Za-z_])"
        },
        {
          "name": "keyword.extern-linkage.gobol",
          "match": "(?<=extern\\s)\"[^\"]*\"",
          "captures": {
            "0": { "name": "string.quoted.double.linkage.gobol" }
          }
        },
        {
          "name": "constant.language.gobol",
          "match": "\\b(true|false|null|none|nil|self|Self)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.gobol",
          "match": "\\b(int|float|str|bool|void|char|unit)\\b"
        },
        {
          "name": "storage.type.array.gobol",
          "match": "(?<=\\])(\\[\\])",
          "captures": {
            "1": { "name": "storage.type.array.gobol" }
          }
        },
        {
          "name": "entity.name.type.gobol",
          "match": "\\b([A-Z][[:word:]]*)\\b"
        },
        {
          "comment": "Type annotation after a single `:` (`var x: Vec<int>`, `func f(a: T): U`). The negative lookbehind `(?<!:)` prevents the colon of the `::` scope operator (e.g. `builtins::gobol_mem_load`, `Vec::new`) from being treated as an annotation, so qualified function names keep their `entity.name.function` color.",
          "name": "entity.name.type.alias.gobol",
          "match": "(?<!:):\\s*([a-zA-Z_][[:word:]]*(?:::[a-zA-Z_][[:word:]]*)*)"
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "comment": "`from module import member1, member2;` — module is support.other.module, members are entity.name.function.",
          "match": "\\b(from)\\s+([a-zA-Z_][[:word:]]*)\\s+(import)\\s+([a-zA-Z_][[:word:]]*(?:\\s*,\\s*[a-zA-Z_][[:word:]]*)*)",
          "captures": {
            "1": { "name": "keyword.declaration.gobol" },
            "2": { "name": "support.other.module.gobol" },
            "3": { "name": "keyword.declaration.gobol" },
            "4": {
              "patterns": [
                {
                  "match": "[a-zA-Z_][[:word:]]*",
                  "name": "entity.name.function.gobol"
                },
                {
                  "match": ",",
                  "name": "punctuation.separator.comma.gobol"
                }
              ]
            }
          }
        },
        {
          "comment": "`import module as alias;` — module is support.other.module, alias is entity.name.type.alias.",
          "match": "\\b(import)\\s+([a-zA-Z_][[:word:]]*)\\s+(as)\\s+([a-zA-Z_][[:word:]]*)",
          "captures": {
            "1": { "name": "keyword.declaration.gobol" },
            "2": { "name": "support.other.module.gobol" },
            "3": { "name": "keyword.declaration.gobol" },
            "4": { "name": "entity.name.type.alias.gobol" }
          }
        },
        {
          "comment": "`import module;` — only the module name (first segment, no `::` path).",
          "match": "\\b(import)\\s+([a-zA-Z_][[:word:]]*)",
          "captures": {
            "1": { "name": "keyword.declaration.gobol" },
            "2": { "name": "support.other.module.gobol" }
          }
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "comment": "Module qualifier before `::` (e.g. `io::println`, `Vec::new`).",
          "name": "support.other.module.gobol",
          "match": "\\b([a-zA-Z_][[:word:]]*)(?=\\:\\:)"
        },
        {
          "comment": "Function/method name. Allows optional generic params between name and `(`: `f()`, `f<T>()`, `f<T, U>()`, `Vec::new()`.",
          "name": "entity.name.function.gobol",
          "match": "\\b([[:alpha:]_][[:word:]]*)(?=(?:<[^<>]*>)?\\s*\\()"
        },
        {
          "name": "variable.other.gobol",
          "match": "\\b[[:alpha:]_][[:word:]]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.scope.gobol",
          "match": "::"
        },
        {
          "name": "keyword.operator.range.gobol",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.range.gobol",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.arrow.gobol",
          "match": "->"
        },
        {
          "name": "keyword.operator.fat-arrow.gobol",
          "match": "=>"
        },
        {
          "name": "keyword.operator.assignment.gobol",
          "match": "(\\+=|\\-=|\\*=|\\/=|%=|&=|\\|=|\\^=|<<=|>>=|=)"
        },
        {
          "name": "keyword.operator.comparison.gobol",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.gobol",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.bitwise.gobol",
          "match": "(&|\\||\\^|<<|>>)"
        },
        {
          "name": "keyword.operator.arithmetic.gobol",
          "match": "(\\+|\\-|\\*|\\/|%)"
        },
        {
          "name": "keyword.operator.question.gobol",
          "match": "\\?"
        },
        {
          "name": "punctuation.separator.colon.gobol",
          "match": ":"
        },
        {
          "name": "punctuation.accessor.dot.gobol",
          "match": "\\.(?!\\.)"
        },
        {
          "name": "punctuation.terminator.semicolon.gobol",
          "match": ";"
        },
        {
          "name": "punctuation.separator.comma.gobol",
          "match": ","
        },
        {
          "name": "punctuation.definition.bracket.square.gobol",
          "match": "\\[|\\]"
        }
      ]
    }
  }
}
