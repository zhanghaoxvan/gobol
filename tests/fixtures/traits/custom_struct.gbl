// Test trait-based operator dispatch with custom function
// Demonstrates that +, -, * operators work through intrinsic method dispatch
import io;

// Helper: uses operators which are desugared to trait method calls (add, mul, sub)
func compute(a: int, b: int, c: int): int {
    a * b + c - a
}

func main() {
    // 5 * 3 = 15  (mul intrinsic)
    // 15 + 2 = 17 (add intrinsic)
    // 17 - 5 = 12 (sub intrinsic)
    var result = compute(5, 3, 2);
    io.println(@"compute(5, 3, 2) = {result}");
}
