// user don't need this name directly
// it's the base database of the gobol
// when user use the 'type[<the inital count of the vec and don't must complete this>]'
// like var v: int[] => var v: new vec<int>()
// or var v1: int[32] => var v1: new vec<int>()
// it calls this library
#[library_features(hidden = true)]

import ref;
import iterator;

struct Vec<T> {
    _data: T[],
    _len: int,
    _cap: int
};

impl<T> New<T> for Vec<T> {
    func new(): Vec<T> {
        Vec {
            _data: new T[0],
            _len: 0,
            _cap: 0,
        }
    }

    func new(arr: T[]): Vec<T> {
        var v: Vec<T> = new Vec<T>();
        for item in arr {
            v.push(item);
        }
        v
    }
    
    func new(capacity: int): Vec<T> {
        Vec {
            _data: new T[capacity],
            _len: 0,
            _cap: capacity,
        }
    }
}

impl<T> Vec<T> {
    func len(self): int {
        self._len
    }
    
    func cap(self): int {
        self._cap
    }
    
    func is_empty(self): bool {
        self._len == 0
    }
    
    func get(self, index: int): T {
        if index < 0 || index >= self._len {
            panic("index out of bounds"); 
        }
        self._data[index]
    }
    
    func set(self, index: int, value: T) {
        if index < 0 || index >= self._len {
            panic("index out of bounds"); 
        }
        var addr = builtins::gobol_array_elem_addr(self._data, index);
        builtins::gobol_mem_store(addr, value);
    }
    
    func push(self, value: T) {
        if self._len >= self._cap {
            self._grow();
        }
        if self._cap == 0 {
            self._data = new T[4];
            self._cap = 4;
        }
        var addr = builtins::gobol_array_elem_addr(self._data, self._len);
        builtins::gobol_mem_store(addr, value);
        self._len = self._len + 1;
    }
    
    func pop(self): T {
        if self._len == 0 {
            panic("pop from empty vec"); 
        }
        self._len = self._len - 1;
        var value: T = self._data[self._len];
        value
    }
    
    convert T[](self): T[] {
        var result: T[] = new T[self._len];
        for i in 0..self._len {
            result[i] = self._data[i];
        }
        result
    }
    
    func iter(self): VecIterator<T> {
        VecIterator<T>::new(self._data, self._len)
    }

    func index(self, index: int): T {
        self.get(index)
    }

    func index_mut(self, index: int): Ref<T> {
        if index < 0 || index >= self._len {
            panic("index out of bounds");
        }
        var addr = builtins::gobol_array_elem_addr(self._data, index);
        Ref<T>::new(addr)
    }

    func _grow(self) {
        var new_cap: int = 0;
        if self._cap == 0 {
            new_cap = 4;
        } else {
            new_cap = self._cap * 2;
        }
        var new_data: T[] = new T[new_cap];
        for i in 0..self._len {
            new_data[i] = self._data[i];
        }
        self._data = new_data;
        self._cap = new_cap;
    }
};

struct VecIterator<T> {
    _data: T[],
    _len: int,
    _index: int
};

impl<T> New<T> for VecIterator<T> {
    func new(data: T[], len: int): VecIterator<T> {
        VecIterator { _data: data, _len: len, _index: 0 }
    }
}

impl<T> Iterator<T> for VecIterator<T> {
    type Value = T;
    func next(self): Option<T> {
        if self._index >= self._len {
            return Option::None;
        }
        var value: T = self._data[self._index];
        self._index = self._index + 1;
        Option::Some(value)
    }
};