// std/mod.gbl - Standard library entry point.
// User code writes `import std;` to load this file which transitively imports all submodules.
// Each submodule's short name (e.g. "io") is registered globally so user code can
// call io::println(...), debug::println(...), etc. directly after `import std;`.
import io;
import int;
import float;
import vec;
import range;
import new;
import trait;
import str;
import math;
import fs;
import net;
import debug;
import assert;
import ops;
import ref;
import result;
import thread;
import mem;
import cmp;
import iterator;
import option;

// Submodules are referenced through their full `std::` path from user code,
// e.g. `std::io::println(...)` / `std::math::abs(...)`. No unified re-export
// list is maintained here, so each submodule is addressed by its `std::<name>`
// prefix instead of a bare `<name>`.
